# Interactive BCM Proposal - Environment Configuration
# Copy this file to .env.local and configure with your actual values

# =============================================================================
# API ENDPOINTS
# =============================================================================

# Intent form submission endpoint
# This is where form data will be sent when users express interest
# Example: https://api.lavitacode.com.br/proposals/intent
VITE_INTENT_ENDPOINT=https://api.example.com/intent

# External scheduling system URL (Calendly, Acuity, or custom)
# This link opens when users click "Schedule Meeting"
# Example: https://calendly.com/lavitacode/bcm-proposal
VITE_SCHEDULING_URL=https://calendly.com/lavitacode

# =============================================================================
# PROPOSAL CONFIGURATION
# =============================================================================

# Proposal validity deadline (ISO 8601 format with timezone)
# Format: YYYY-MM-DDTHH:mm:ss±HH:mm
# Default: May 22, 2026 at 23:59:59 in São Paulo timezone (UTC-3)
VITE_PROPOSAL_DEADLINE=2026-05-22T23:59:59-03:00

# =============================================================================
# ANALYTICS INTEGRATION
# =============================================================================

# Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX
# Leave empty to disable Google Analytics tracking
# Get your ID from: https://analytics.google.com/
VITE_GA_TRACKING_ID=

# Hotjar Site ID
# Format: numeric ID (e.g., 1234567)
# Leave empty to disable Hotjar tracking
# Get your ID from: https://insights.hotjar.com/
VITE_HOTJAR_ID=

# =============================================================================
# PRODUCTION BUILD CONFIGURATION
# =============================================================================

# Application base URL (used for canonical URLs and social sharing)
# Example: https://proposta-bcm.lavitacode.com.br
VITE_APP_URL=https://example.com

# Enable/disable source maps in production builds
# Set to 'true' for debugging, 'false' for smaller bundles
VITE_SOURCEMAP=false

# =============================================================================
# OPTIONAL: FEATURE FLAGS
# =============================================================================

# Enable debug mode (shows additional console logs)
VITE_DEBUG_MODE=false

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true